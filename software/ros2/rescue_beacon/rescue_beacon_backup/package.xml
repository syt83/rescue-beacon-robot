<?xml version="1.0"?>
<package format="3">

  <name>rescue_beacon</name>
  <version>0.1.0</version>

  <description>
    ROS2 package for the Rescue Beacon Robot.
    Provides LiDAR-based navigation and robot control nodes.
  </description>

  <maintainer email="team@example.com">
    Rescue Beacon Robot Team
  </maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>